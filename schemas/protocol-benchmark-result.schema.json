{
  "$ref": "#/definitions/protocol-benchmark-result",
  "definitions": {
    "protocol-benchmark-result": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "const": "PROTOCOL"
        },
        "status": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "FAILED",
            "RUNNING"
          ]
        },
        "artifact_slug": {
          "type": "string"
        },
        "benchmark_suite": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_suite_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "sdk_version": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "source_repository_url": {
          "type": "string",
          "format": "uri"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        },
        "environment": {
          "type": "object",
          "properties": {
            "operating_system": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            },
            "python_version": {
              "type": "string"
            },
            "node_version": {
              "type": "string"
            },
            "packages": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            },
            "hardware": {
              "type": "object",
              "additionalProperties": {},
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {
            "packages": {},
            "hardware": {}
          }
        },
        "summary_metrics": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        },
        "reproducibility_hash": {
          "type": "string",
          "minLength": 1
        },
        "reproducibility_hash_version": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "is_demo": {
          "type": "boolean",
          "default": false
        },
        "owner_username": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "type": "string",
          "enum": [
            "PUBLIC",
            "PRIVATE"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "execution_class": {
          "type": "string",
          "enum": [
            "DEMO",
            "SIMULATION",
            "HARDWARE",
            "ANALYTICAL"
          ]
        },
        "transformation_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "IMPORT",
                  "EXPORT",
                  "CONVERSION",
                  "TRANSPILATION",
                  "OPTIMIZATION",
                  "ZX_REWRITE",
                  "MITIGATION",
                  "LAYOUT",
                  "ROUTING"
                ]
              },
              "adapter": {
                "type": "string",
                "minLength": 1
              },
              "adapter_version": {
                "type": "string",
                "minLength": 1
              },
              "library_version": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "object",
                "additionalProperties": {},
                "default": {}
              },
              "input_circuit_hash": {
                "type": "string",
                "minLength": 1
              },
              "output_circuit_hash": {
                "type": "string",
                "minLength": 1
              },
              "loss_report": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "feature": {
                      "type": "string",
                      "minLength": 1
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "semantic",
                        "structural",
                        "cosmetic"
                      ]
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "rejected",
                        "dropped",
                        "approximated"
                      ]
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    },
                    "location": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "feature",
                    "severity",
                    "action",
                    "detail"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "equivalence": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "string",
                    "enum": [
                      "NOT_CHECKED",
                      "NUMERICALLY_CHECKED",
                      "SYMBOLICALLY_REDUCED",
                      "PROVED_BY_SUPPORTED_REWRITE",
                      "FAILED",
                      "INCONCLUSIVE"
                    ]
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tolerance": {
                    "type": "number",
                    "minimum": 0
                  },
                  "global_phase_ignored": {
                    "type": "boolean"
                  },
                  "qubit_count": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "counterexample": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "level"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "adapter",
              "adapter_version"
            ],
            "additionalProperties": false
          }
        },
        "metric_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "shots": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "runtime_seconds": {
                "type": "number",
                "minimum": 0
              },
              "memory_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "seed": {
                "type": "integer",
                "minimum": 0
              },
              "metadata": {
                "type": "object",
                "additionalProperties": {},
                "default": {}
              },
              "sequence_length": {
                "type": "integer",
                "minimum": 0
              },
              "survival_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "standard_error": {
                "type": "number",
                "minimum": 0
              },
              "sequences": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "metric"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "name",
        "domain",
        "status",
        "benchmark_suite",
        "benchmark_suite_version",
        "schema_version",
        "reproducibility_hash"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

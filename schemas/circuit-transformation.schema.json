{
  "$ref": "#/definitions/circuit-transformation",
  "definitions": {
    "circuit-transformation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "IMPORT",
            "EXPORT",
            "CONVERSION",
            "TRANSPILATION",
            "OPTIMIZATION",
            "ZX_REWRITE",
            "MITIGATION",
            "LAYOUT",
            "ROUTING"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "library_version": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        },
        "input_circuit_hash": {
          "type": "string",
          "minLength": 1
        },
        "output_circuit_hash": {
          "type": "string",
          "minLength": 1
        },
        "loss_report": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "feature": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "semantic",
                  "structural",
                  "cosmetic"
                ]
              },
              "action": {
                "type": "string",
                "enum": [
                  "rejected",
                  "dropped",
                  "approximated"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string"
              }
            },
            "required": [
              "feature",
              "severity",
              "action",
              "detail"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "equivalence": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "NOT_CHECKED",
                "NUMERICALLY_CHECKED",
                "SYMBOLICALLY_REDUCED",
                "PROVED_BY_SUPPORTED_REWRITE",
                "FAILED",
                "INCONCLUSIVE"
              ]
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "tolerance": {
              "type": "number",
              "minimum": 0
            },
            "global_phase_ignored": {
              "type": "boolean"
            },
            "qubit_count": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "counterexample": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "level"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "adapter",
        "adapter_version"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

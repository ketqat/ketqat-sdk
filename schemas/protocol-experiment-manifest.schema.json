{
  "$ref": "#/definitions/protocol-experiment-manifest",
  "definitions": {
    "protocol-experiment-manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "const": "PROTOCOL"
        },
        "benchmark": {
          "type": "object",
          "properties": {
            "suite": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "suite",
            "version"
          ],
          "additionalProperties": false
        },
        "experiment": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "properties": {
            "repository_url": {
              "type": "string",
              "format": "uri"
            },
            "commit_sha": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "sampling": {
          "type": "object",
          "properties": {
            "shots": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "shots",
            "seed"
          ],
          "additionalProperties": false
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "environment": {
          "type": "object",
          "properties": {
            "operating_system": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            },
            "python_version": {
              "type": "string"
            },
            "node_version": {
              "type": "string"
            },
            "packages": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            },
            "hardware": {
              "type": "object",
              "additionalProperties": {},
              "default": {}
            }
          },
          "additionalProperties": false
        },
        "protocol": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "randomized-benchmarking"
            },
            "qubits": {
              "type": "number",
              "enum": [
                1,
                2
              ]
            },
            "sequence_lengths": {
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "minItems": 3
            },
            "sequences_per_length": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "noise": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "const": "depolarizing"
                },
                "depolarizing_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "model",
                "depolarizing_rate"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "qubits",
            "sequence_lengths",
            "sequences_per_length",
            "noise"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "domain",
        "benchmark",
        "experiment",
        "sampling",
        "metrics",
        "protocol"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

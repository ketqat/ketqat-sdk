              "targets": {
                "type": "string",
                "pattern": "^(?:objective|success_criteria(?:\\[[0-9]{1,3}\\])?|accuracy_requirement|runtime_constraint|budget_constraint|problem_size|current_classical_method|why_quantum|limitations(?:\\[[0-9]{1,3}\\])?)$"

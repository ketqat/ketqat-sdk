                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "pattern": "^(?:0|-?[1-9][0-9]{0,63})$"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "unit": {
                                    "type": "string",
                                    "enum": [

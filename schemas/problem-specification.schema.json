{
  "$ref": "#/definitions/problem-specification",
  "definitions": {
    "problem-specification": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "hash_rules_id": {
          "type": "string",
          "const": "study-v1"
        },
        "study_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "objective": {
          "type": "object",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "string",
              "enum": [
                "MEASURED",
                "USER_PROVIDED",
                "DERIVED",
                "MODELLED",
                "UNKNOWN"
              ]
            },
            "origin": {
              "type": "string",
              "enum": [
                "INFERRED",
                "CONFIRMED"
              ]
            }
          },
          "required": [
            "value",
            "evidence",
            "origin"
          ],
          "additionalProperties": false
        },

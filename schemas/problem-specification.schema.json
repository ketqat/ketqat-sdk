                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}(?:\\.[a-z][a-z0-9_]{0,63}){0,7}$"
                      },
                      "comparator": {
                        "type": "string",
                        "enum": [
                          "LESS_THAN",
                          "AT_MOST",
                          "EQUAL",
                          "AT_LEAST",
                          "GREATER_THAN",
                          "EXISTS",
                          "DOES_NOT_EXIST",
                          "IS_TRUE",
                          "IS_FALSE"
                        ]
                      },

                                      "microseconds",
                                      "milliseconds",
                                      "seconds",
                                      "minutes",
                                      "hours",
                                      "days"
                                    ]
                                  }
                                },
                                "required": [
                                  "dimension",
                                  "value",
                                  "exact_value",
                                  "unit"
                                ],
                                "additionalProperties": false

{
  "$ref": "#/definitions/hardware-model-snapshot",
  "definitions": {
    "hardware-model-snapshot": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "enum": [
            "SUPERCONDUCTING",
            "TRAPPED_ION",
            "NEUTRAL_ATOM",
            "PHOTONIC",
            "SPIN",
            "GENERIC_REFERENCE"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "OBSERVATION",
            "ROADMAP",
            "USER_ASSUMPTION"
          ]
        },
        "physical_error_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "cycle_time_ns": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "physical_qubit_capacity": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_published_on": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_on": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "snapshot_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "name",
        "architecture",
        "basis",
        "physical_error_rate",
        "cycle_time_ns",
        "physical_qubit_capacity",
        "operations",
        "source",
        "source_url",
        "source_published_on",
        "retrieved_on",
        "confidence",
        "limitations",
        "snapshot_version"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

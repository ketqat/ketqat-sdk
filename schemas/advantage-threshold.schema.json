                  "NO_CLASSICAL_BASELINE",
                  "NO_CLASSICAL_RUNTIME",
                  "NO_CLASSICAL_COST",
                  "NO_ECONOMIC_MODEL",
                  "NO_MACHINE_COST_RATE",
                  "NO_HARDWARE_CAPACITY",
                  "NO_RUNTIME_TARGET",
                  "ESTIMATE_INFEASIBLE",
                  "FACTORY_NOT_SIZED"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "threshold",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "scenario_name",
        "scenario_revision",
        "max_physical_error_rate",
        "max_physical_error_rate_within_capacity",
        "required_code_distance",
        "max_cycle_time_for_runtime_target",
        "min_factory_throughput_for_runtime_target",
        "required_logical_qubit_capacity",
        "required_total_physical_qubit_capacity",
        "capacity_headroom",
        "max_cycle_time_to_beat_classical_runtime",
        "runtime_speedup_over_classical",
        "max_machine_cost_per_second",
        "max_physical_qubit_second_cost",
        "break_even_runtime",
        "break_even_machine_cost_per_second",
        "projected_quantum_cost",
        "cost_ratio_to_classical",
        "refusals",
        "required_conditions",
        "limitations"
      ],
      "additionalProperties": false
    }

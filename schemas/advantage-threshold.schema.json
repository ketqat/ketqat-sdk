{
  "$ref": "#/definitions/advantage-threshold",
  "definitions": {
    "advantage-threshold": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "scenario_name": {
          "type": "string",
          "minLength": 1
        },
        "scenario_revision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "max_physical_error_rate": {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "bound": {
              "type": "string",
              "enum": [
                "POINT",
                "UPPER_BOUND",
                "LOWER_BOUND"
              ]
            },
            "evidence": {
              "type": "string",
              "enum": [
                "MEASURED",
                "USER_PROVIDED",
                "DERIVED",
                "MODELLED",
                "UNKNOWN"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "model_version": {
              "type": "string",
              "minLength": 1
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "schema_version": {
              "type": "string",
              "minLength": 1
            },
            "uncertainty": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "SENSITIVITY_RANGE",
                    "MODEL_SPREAD",
                    "NOT_CHARACTERIZED"
                  ]
                },
                "low": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "high": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "low",
                "high",
                "basis"
              ],
              "additionalProperties": false
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }

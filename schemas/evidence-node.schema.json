{
  "$ref": "#/definitions/evidence-node",
  "definitions": {
    "evidence-node": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "hash_rules_id": {
          "type": "string",
          "const": "study-v1"
        },
        "study_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "claim",
            "quantity",
            "input",
            "model_ref",
            "result",
            "source",
            "dataset_ref",
            "snapshot_ref"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "subject": {
                  "type": "string",
                  "minLength": 1
                },
                "metric": {
                  "type": "string",
                  "minLength": 1
                },
                "comparator": {
                  "type": "string",
                  "enum": [
                    "LESS_THAN",
                    "AT_MOST",
                    "EQUAL",
                    "AT_LEAST",
                    "GREATER_THAN"
                  ]
                },
                "value": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bound": {
                      "type": "string",
                      "enum": [
                        "POINT",
                        "UPPER_BOUND",
                        "LOWER_BOUND"
                      ]
                    },
                    "evidence": {
                      "type": "string",
                      "enum": [
                        "MEASURED",
                        "USER_PROVIDED",
                        "DERIVED",
                        "MODELLED",
                        "UNKNOWN"
                      ]
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "model_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "assumptions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "schema_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uncertainty": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "SENSITIVITY_RANGE",
                            "MODEL_SPREAD",
                            "NOT_CHARACTERIZED"
                          ]
                        },
                        "low": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "high": {
                          "anyOf": [
                            {
                              "$ref": "#/definitions/evidence-node/properties/claim/anyOf/0/properties/value/properties/uncertainty/properties/low/anyOf/0"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "basis": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "low",
                        "high",
                        "basis"
                      ],
                      "additionalProperties": false
                    },
                    "limitations": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "value",
                    "unit",
                    "bound",
                    "evidence",
                    "source",
                    "model",
                    "model_version",
                    "assumptions",
                    "schema_version",
                    "limitations"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "subject",
                "metric",
                "comparator",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/definitions/evidence-node/properties/claim/anyOf/0/properties/value"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "record_kind": {
                  "type": "string",
                  "minLength": 1
                },
                "hash": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/evidence-node/properties/study_ref"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "record_slug": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "record_kind",
                "hash",
                "record_slug"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "citation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "authors": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "year": {
                  "type": "integer",
                  "minimum": 1900,
                  "maximum": 2200
                },
                "doi": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "bibtex": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "authors"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_published_on": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_on": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "$ref": "#/definitions/evidence-node/properties/study_ref"
        }
      },
      "required": [
        "schema_version",
        "hash_rules_id",
        "study_ref",
        "kind",
        "label",
        "claim",
        "quantity",
        "reference",
        "citation",
        "limitations",
        "source_published_on",
        "retrieved_on",
        "content_hash"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

{
  "$ref": "#/definitions/resource-scenario",
  "definitions": {
    "resource-scenario": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "preset": {
          "type": "string",
          "enum": [
            "CONSERVATIVE",
            "BASE",
            "OPTIMISTIC",
            "CUSTOM"
          ]
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "hardware": {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "architecture": {
              "type": "string",
              "enum": [
                "SUPERCONDUCTING",
                "TRAPPED_ION",
                "NEUTRAL_ATOM",
                "PHOTONIC",
                "SPIN",
                "GENERIC_REFERENCE"
              ]
            },
            "basis": {
              "type": "string",
              "enum": [
                "OBSERVATION",
                "ROADMAP",
                "USER_ASSUMPTION"
              ]
            },
            "physical_error_rate": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "cycle_time_ns": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "physical_qubit_capacity": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "source_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_published_on": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "retrieved_on": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "confidence": {
              "type": "string",
              "enum": [
                "HIGH",
                "MEDIUM",
                "LOW"
              ]
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "snapshot_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "schema_version",
            "name",
            "architecture",
            "basis",
            "physical_error_rate",
            "cycle_time_ns",
            "physical_qubit_capacity",
            "operations",
            "source",
            "source_url",
            "source_published_on",
            "retrieved_on",
            "confidence",
            "limitations",
            "snapshot_version"
          ],
          "additionalProperties": false
        },
        "qec": {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string",
              "minLength": 1
            },
            "scheme": {
              "type": "string",
              "enum": [
                "SURFACE_CODE_ROTATED"
              ]
            },
            "threshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "prefactor": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "prefactor_model": {
              "type": "string",
              "minLength": 1
            },
            "qubits_per_logical_d_squared": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rounds_per_logical_cycle": {
              "type": "string",
              "enum": [
                "DISTANCE"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "schema_version",
            "scheme",
            "threshold",
            "prefactor",
            "prefactor_model",
            "qubits_per_logical_d_squared",
            "rounds_per_logical_cycle",
            "source",
            "limitations"
          ],
          "additionalProperties": false
        },
        "layout_model": {
          "type": "string",
          "enum": [
            "BARE_REGISTER",
            "LATTICE_SURGERY_2D"
          ]
        },
        "factory": {
          "type": "object",
          "properties": {
            "protocol": {
              "type": "string",
              "enum": [
                "FIFTEEN_TO_ONE",
                "NONE"
              ]
            },
            "raw_state_error": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "target_state_error": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "factory_distance": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "parallel_factories": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "rounds_per_distillation": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "protocol",
            "raw_state_error",
            "target_state_error",
            "factory_distance",
            "parallel_factories",
            "rounds_per_distillation"
          ],
          "additionalProperties": false
        },
        "decomposition": {
          "type": "object",
          "properties": {
            "toffoli_t_cost": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "unsupported_gate_policy": {
              "type": "string",
              "enum": [
                "REFUSE",
                "REPORT_AS_UNDERESTIMATE"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "toffoli_t_cost",
            "unsupported_gate_policy",
            "source"
          ],
          "additionalProperties": false
        },
        "error_budget": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "runtime_target": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "economics": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "schema_version": {
                  "type": "string",
                  "minLength": 1
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "USER_PROVIDED",
                    "PUBLISHED_QUOTE",
                    "MODELLED"
                  ]
                },
                "machine_cost_per_second": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "physical_qubit_cost_per_second": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "schema_version",
                "currency",
                "basis",
                "machine_cost_per_second",
                "physical_qubit_cost_per_second",
                "source",
                "limitations"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "estimator": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "name",
        "preset",
        "revision",
        "supersedes",
        "rationale",
        "hardware",
        "qec",
        "layout_model",
        "factory",
        "decomposition",
        "error_budget",
        "runtime_target",
        "economics",
        "estimator"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

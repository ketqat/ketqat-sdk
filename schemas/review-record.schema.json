{
  "$ref": "#/definitions/review-record",
  "definitions": {
    "review-record": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "hash_rules_id": {
          "type": "string",
          "const": "study-v1"
        },
        "study_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "subject_node_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "ACCEPTED",
            "CHANGES_REQUESTED",
            "REJECTED"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "$ref": "#/definitions/review-record/properties/subject_node_hash"
        }
      },
      "required": [
        "schema_version",
        "hash_rules_id",
        "study_ref",
        "subject_node_hash",
        "verdict",
        "rationale",
        "reviewer",
        "content_hash"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

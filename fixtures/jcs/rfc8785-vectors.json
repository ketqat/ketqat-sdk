{
  "source": "RFC 8785, JSON Canonicalization Scheme (JCS), June 2020",
  "note": "Vectors transcribed from the RFC itself, not produced by either implementation. A divergence between the TypeScript and Python canonicalizers therefore fails against the specification, and names which side is wrong.",
  "number_serialization": {
    "reference": "RFC 8785 Appendix B, Table 1",
    "note": "The IEEE 754 column is a 64-bit big-endian hex bit pattern, which is the authority for the value; the JSON column is the required serialization.",
    "samples": [
      {
        "ieee754": "0000000000000000",
        "json": "0",
        "comment": "Zero"
      },
      {
        "ieee754": "8000000000000000",
        "json": "0",
        "comment": "Minus zero"
      },
      {
        "ieee754": "0000000000000001",
        "json": "5e-324",
        "comment": "Min pos number"
      },
      {
        "ieee754": "8000000000000001",
        "json": "-5e-324",
        "comment": "Min neg number"
      },
      {
        "ieee754": "7fefffffffffffff",
        "json": "1.7976931348623157e+308",
        "comment": "Max pos number"
      },
      {
        "ieee754": "ffefffffffffffff",
        "json": "-1.7976931348623157e+308",
        "comment": "Max neg number"
      },
      {
        "ieee754": "4340000000000000",
        "json": "9007199254740992",
        "comment": "Max pos int"
      },
      {
        "ieee754": "c340000000000000",
        "json": "-9007199254740992",
        "comment": "Max neg int"
      },
      {
        "ieee754": "4430000000000000",
        "json": "295147905179352830000",
        "comment": "~2**68"
      },
      {
        "ieee754": "44b52d02c7e14af5",
        "json": "9.999999999999997e+22",
        "comment": ""
      },
      {
        "ieee754": "44b52d02c7e14af6",
        "json": "1e+23",
        "comment": ""
      },
      {
        "ieee754": "44b52d02c7e14af7",
        "json": "1.0000000000000001e+23",
        "comment": ""
      },
      {
        "ieee754": "444b1ae4d6e2ef4e",
        "json": "999999999999999700000",
        "comment": ""
      },
      {
        "ieee754": "444b1ae4d6e2ef4f",
        "json": "999999999999999900000",
        "comment": ""
      },
      {
        "ieee754": "444b1ae4d6e2ef50",
        "json": "1e+21",
        "comment": ""
      },
      {
        "ieee754": "3eb0c6f7a0b5ed8c",
        "json": "9.999999999999997e-7",
        "comment": ""
      },
      {
        "ieee754": "3eb0c6f7a0b5ed8d",
        "json": "0.000001",
        "comment": ""
      },
      {
        "ieee754": "41b3de4355555553",
        "json": "333333333.3333332",
        "comment": ""
      },
      {
        "ieee754": "41b3de4355555554",
        "json": "333333333.33333325",
        "comment": ""
      },
      {
        "ieee754": "41b3de4355555555",
        "json": "333333333.3333333",
        "comment": ""
      },
      {
        "ieee754": "41b3de4355555556",
        "json": "333333333.3333334",
        "comment": ""
      },
      {
        "ieee754": "41b3de4355555557",
        "json": "333333333.33333343",
        "comment": ""
      },
      {
        "ieee754": "becbf647612f3696",
        "json": "-0.0000033333333333333333",
        "comment": ""
      },
      {
        "ieee754": "43143ff3c1cb0959",
        "json": "1424953923781206.2",
        "comment": "Round to even"
      }
    ],
    "must_terminate": [
      {
        "ieee754": "7fffffffffffffff",
        "comment": "NaN"
      },
      {
        "ieee754": "7ff0000000000000",
        "comment": "Infinity"
      }
    ]
  },
  "primitive_serialization": {
    "reference": "RFC 8785 Section 3.2.2 (input), Section 3.2.3 (canonical form) and Section 3.2.4 (UTF-8 bytes)",
    "note": "expected_utf8_hex is the byte sequence the RFC prints in Section 3.2.4 for this same sample. It is pinned separately from expected_canonical because a digest consumes bytes, not code units: an implementation could produce the right characters and the wrong encoding, and only this column would notice.",
    "input_json": "{\"numbers\":[333333333.33333329,1E30,4.50,2e-3,0.000000000000000000000000001],\"string\":\"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\/\",\"literals\":[null,true,false]}",
    "expected_canonical": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"€$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}",
    "expected_utf8_hex": "7b226c69746572616c73223a5b6e756c6c2c747275652c66616c73655d2c226e756d62657273223a5b3333333333333333332e333333333333332c31652b33302c342e352c302e3030322c31652d32375d2c22737472696e67223a22e282ac245c75303030665c6e4127425c225c5c5c5c5c222f227d"
  },
  "property_sorting": {
    "reference": "RFC 8785 Section 3.2.3",
    "note": "U+1F600 sorts as its high surrogate D83D and therefore precedes U+FB33. Code-point order would put U+FB33 first, which is the divergence this vector exists to catch.",
    "input_json": "{\"\\u20ac\":\"Euro Sign\",\"\\r\":\"Carriage Return\",\"\\ufb33\":\"Hebrew Letter Dalet With Dagesh\",\"1\":\"One\",\"\\ud83d\\ude00\":\"Emoji: Grinning Face\",\"\\u0080\":\"Control\",\"\\u00f6\":\"Latin Small Letter O With Diaeresis\"}",
    "expected_value_order": [
      "Carriage Return",
      "One",
      "Control",
      "Latin Small Letter O With Diaeresis",
      "Euro Sign",
      "Emoji: Grinning Face",
      "Hebrew Letter Dalet With Dagesh"
    ]
  }
}

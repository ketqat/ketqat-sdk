{
  "name": "ketqat-sdk",
  "version": "0.2.0",
  "description": "Typed contracts, schemas, reproducibility hashing, and a REST client for KetQat -- the vendor-neutral registry for reproducible quantum error-correction and quantum-algorithm research.",
  "keywords": [
    "quantum-computing",
    "quantum-error-correction",
    "qec",
    "reproducibility",
    "benchmarking",
    "stim",
    "pymatching",
    "ketqat"
  ],
  "homepage": "https://ketqat.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ketqat/ketqat-sdk.git"
  },
  "bugs": "https://github.com/ketqat/ketqat-sdk/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./reproducibility": {
      "types": "./dist/reproducibility/index.d.ts",
      "import": "./dist/reproducibility/index.js"
    },
    "./compatibility": {
      "types": "./dist/compatibility/index.d.ts",
      "import": "./dist/compatibility/index.js"
    },
    "./circuit": {
      "types": "./dist/circuit/index.d.ts",
      "import": "./dist/circuit/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./demo": {
      "types": "./dist/demo/index.d.ts",
      "import": "./dist/demo/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./hardware": {
      "types": "./dist/hardware/profile.d.ts",
      "import": "./dist/hardware/profile.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "examples"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/generate-schemas.mjs",
    "clean": "rm -rf dist",
    "generate:schemas": "npm run build",
    "test": "npm run build && node tests/sdk.test.mjs && npm run verify:package-contents && npm run verify:dist-tracked && npm run verify:schema-sync && npm run verify:license && npm run verify:citation && npm run verify:workflows",
    "test:python": "python3.11 -m pytest python/tests",
    "verify:clean-install": "node scripts/verify-npm-clean-install.mjs",
    "verify:package-contents": "node scripts/verify-package-contents.mjs",
    "verify:quickstart": "bash scripts/verify-quickstart.sh",
    "prepublishOnly": "npm run build",
    "verify:dist-tracked": "node scripts/verify-dist-tracked.mjs",
    "verify:schema-sync": "node scripts/verify-schema-sync.mjs",
    "verify:worker-image": "node scripts/verify-worker-image.mjs",
    "verify:license": "node scripts/verify-license-integrity.mjs",
    "verify:citation": "node scripts/verify-citation.mjs",
    "verify:workflows": "node scripts/verify-workflow-hardening.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "bin": {
    "ketqat-engine": "./dist/cli/bin.js"
  }
}

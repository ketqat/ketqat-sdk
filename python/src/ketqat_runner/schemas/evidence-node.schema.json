{
  "$ref": "#/definitions/evidence-node",
  "definitions": {
    "evidence-node": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "hash_rules_id": {
          "type": "string",
          "const": "study-v1"
        },
        "study_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "claim",
            "quantity",
            "assumption",
            "input",
            "model_ref",
            "result",
            "capsule_ref",
            "source",
            "dataset_ref",
            "snapshot_ref"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "enum": [
            "PUBLIC",
            "PRIVATE"
          ]
        },
        "claim": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "subject_ref": {
                  "type": "object",
                  "properties": {
                    "record_kind": {
                      "type": "string",
                      "enum": [
                        "artifact",
                        "benchmark_suite",
                        "qec_experiment_manifest",
                        "algorithm_experiment_manifest",
                        "protocol_experiment_manifest",
                        "qec_benchmark_result",
                        "algorithm_benchmark_result",
                        "protocol_benchmark_result",
                        "reproducibility_bundle",
                        "verification_evidence",
                        "quantum_workload",
                        "classical_baseline",
                        "resource_scenario",
                        "hardware_model_snapshot",
                        "qec_model_snapshot",
                        "economic_model",
                        "resource_estimate_snapshot",
                        "advantage_threshold",
                        "decision_assessment",
                        "resource_intelligence_bundle",
                        "study",
                        "study_event",
                        "problem_specification",
                        "study_plan",
                        "confirmation_receipt",
                        "study_task_authorization",
                        "task_outcome",
                        "evidence_node",
                        "evidence_edge",
                        "execution_capsule",
                        "research_package",
                        "review_record",
                        "reproduction_record"
                      ],
                      "description": "Record kinds an evidence reference may name, vocabulary evidence-record-kinds-v1."
                    },
                    "hash": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "record_slug": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "record_kind",
                    "hash",
                    "record_slug"
                  ],
                  "additionalProperties": false
                },
                "metric": {
                  "type": "string",
                  "minLength": 1
                },
                "comparator": {
                  "type": "string",
                  "enum": [
                    "LESS_THAN",
                    "AT_MOST",
                    "EQUAL",
                    "AT_LEAST",
                    "GREATER_THAN"
                  ]
                },
                "value_ref": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "value_node",
                        "result_field"
                      ]
                    },
                    "node_hash": {
                      "$ref": "#/definitions/evidence-node/properties/claim/anyOf/0/properties/subject_ref/properties/hash/anyOf/0"
                    },
                    "field_path": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(?:\\/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "node_hash",
                    "field_path"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "subject_ref",
                "metric",
                "comparator",
                "value_ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "quantity": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "bound": {
                  "type": "string",
                  "enum": [
                    "POINT",
                    "UPPER_BOUND",
                    "LOWER_BOUND"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "enum": [
                    "MEASURED",
                    "USER_PROVIDED",
                    "DERIVED",
                    "MODELLED",
                    "UNKNOWN"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "model_version": {
                  "type": "string",
                  "minLength": 1
                },
                "assumptions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "schema_version": {
                  "type": "string",
                  "minLength": 1
                },
                "uncertainty": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "SENSITIVITY_RANGE",
                        "MODEL_SPREAD",
                        "NOT_CHARACTERIZED"
                      ]
                    },
                    "low": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "high": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/evidence-node/properties/quantity/anyOf/0/properties/uncertainty/properties/low/anyOf/0"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "basis": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "low",
                    "high",
                    "basis"
                  ],
                  "additionalProperties": false
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "value",
                "unit",
                "bound",
                "evidence",
                "source",
                "model",
                "model_version",
                "assumptions",
                "schema_version",
                "limitations"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/definitions/evidence-node/properties/claim/anyOf/0/properties/subject_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "citation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "authors": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "year": {
                  "type": "integer",
                  "minimum": 1900,
                  "maximum": 2200
                },
                "doi": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "bibtex": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "authors"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_published_on": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_on": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "$ref": "#/definitions/evidence-node/properties/claim/anyOf/0/properties/subject_ref/properties/hash/anyOf/0"
        }
      },
      "required": [
        "schema_version",
        "hash_rules_id",
        "study_ref",
        "kind",
        "label",
        "visibility",
        "claim",
        "quantity",
        "reference",
        "citation",
        "limitations",
        "source_published_on",
        "retrieved_on",
        "content_hash"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

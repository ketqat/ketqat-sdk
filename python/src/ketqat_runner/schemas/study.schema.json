{
  "$ref": "#/definitions/study",
  "definitions": {
    "study": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "hash_rules_id": {
          "type": "string",
          "const": "study-v1"
        },
        "study_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "core": {
          "type": "object",
          "properties": {
            "study_type": {
              "type": "string",
              "enum": [
                "FTQC_FEASIBILITY",
                "QEC_LOGICAL_BENCHMARK"
              ]
            },
            "project_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "is_demo": {
              "type": "boolean"
            }
          },
          "required": [
            "study_type",
            "project_ref",
            "is_demo"
          ],
          "additionalProperties": false
        },
        "presentation": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "DRAFT",
                "SPECIFIED",
                "PLANNED",
                "AWAITING_CONFIRMATION",
                "RUNNING",
                "NEEDS_INPUT",
                "CONCLUDED",
                "REFUSED",
                "RETRACTED",
                "CANCELLED",
                "SUPERSEDED"
              ]
            },
            "latest_specification": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "revision_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "revision_hash",
                    "revision"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "latest_plan": {
              "anyOf": [
                {
                  "$ref": "#/definitions/study/properties/presentation/properties/latest_specification/anyOf/0"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "title",
            "status",
            "latest_specification",
            "latest_plan"
          ],
          "additionalProperties": false
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "$ref": "#/definitions/study/properties/presentation/properties/latest_specification/anyOf/0/properties/revision_hash"
        }
      },
      "required": [
        "schema_version",
        "hash_rules_id",
        "study_id",
        "core",
        "presentation",
        "content_hash"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

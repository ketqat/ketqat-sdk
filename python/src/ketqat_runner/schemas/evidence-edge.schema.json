{
  "$ref": "#/definitions/evidence-edge",
  "definitions": {
    "evidence-edge": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "hash_rules_id": {
          "type": "string",
          "const": "study-v1"
        },
        "study_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "derived_from",
            "used_model",
            "used_input",
            "supports",
            "contradicts",
            "supersedes"
          ]
        },
        "from_node_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "to_node_hash": {
          "$ref": "#/definitions/evidence-edge/properties/from_node_hash"
        },
        "asserted_by": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "$ref": "#/definitions/evidence-edge/properties/from_node_hash"
        }
      },
      "required": [
        "schema_version",
        "hash_rules_id",
        "study_ref",
        "kind",
        "from_node_hash",
        "to_node_hash",
        "asserted_by",
        "rationale",
        "content_hash"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
